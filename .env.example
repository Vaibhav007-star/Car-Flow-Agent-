# Google Flow Automation Configuration

# URL for Google Flow (Google Labs)
# Default is Google Labs Flow: https://labs.google/fx/tools/flow
FLOW_URL=https://labs.google/fx/tools/flow

# Headless mode: false allows manual Google login and visual monitoring
HEADLESS=false

# Timeouts in seconds
PAGE_TIMEOUT_SEC=60
GENERATION_TIMEOUT_SEC=300
POLL_INTERVAL_SEC=3

# Output directory for downloaded videos
OUTPUT_DIR=output_videos

# Persistent browser profile directory (keeps your Google login active)
USER_DATA_DIR=.browser_data

# Prompts queue source file
PROMPTS_FILE=prompts.txt

