# Google Flow Automation Configuration

# URL for Google Flow
FLOW_URL=https://flow.google.com/

# Headless mode: false allows visual monitoring
HEADLESS=false

# Timeouts in seconds
PAGE_TIMEOUT_SEC=60
GENERATION_TIMEOUT_SEC=360
POLL_INTERVAL_SEC=3

# Output directory for downloaded videos
OUTPUT_DIR=output_videos

# Persistent browser profile directory (keeps your Google login active)
USER_DATA_DIR=.browser_data

# Prompts queue source file
PROMPTS_FILE=prompts.txt

# Optional: YouTube Data API v3 key to scan real-time viral YouTube Shorts
# Get a free key at https://console.cloud.google.com/
YOUTUBE_API_KEY=
